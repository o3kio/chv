# Binaries
bin/
# ...but Rust bin *sources* live in `src/bin/` subdirectories (e.g. the
# chv-netbox-sim dev tool) and must stay tracked. Re-include them
# explicitly; the last matching pattern wins.
!crates/chv-netbox-sim/src/bin/
*.exe
*.dll
*.so
*.dylib
/chv-controller
/chv-agent
/chv-bootstrap

# Test artifacts
*.test
*.out
*.log
# Field-qualification evidence: the raw logs are redacted, bounded artifacts
# that must be committed with the report they support, so re-include them
# under docs/evidence despite the generic rule above.
!docs/evidence/**/*.log
*.profraw
coverage.html
coverage.out

# Go
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Data directories (for local development)
data/
volumes/
/images/
*.iso
*.raw
*.qcow2
*.img

# Temporary files
tmp/
temp/
*.tmp
*.bak
# Hidden .tmp* directories: the chv-agent-runtime-ch linux_observation
# suite creates per-test runtime dirs (`.tmpXXXXXX`) inside the crate
# root via `TempDir::new_in(current_dir())` — a stray `git add -A` must
# never swallow them.
.tmp*/

# Rust
# `target/` plus ad-hoc alternate target dirs (e.g. `cargo build --target-dir
# target-dev ...`) — a stray `git add -A` must never swallow build output.
target/
target-*/

# Node
node_modules/

# Build output
dist/

# Agent-specific local state
docs/superpowers
.worktrees/
.claude/worktrees/
.claude/session-reads.txt
.codex/
.kimi/
.agents/
.gstack/
.sccache/

# Review tooling output (per-session, not part of the source tree)
.pr-review-out/

# Per-session task plans (not source-tree material)
task_plan_ci.md

# Playwright local run artifacts (CI uploads its own)
ui/playwright-report/
ui/test-results/

# Python bytecode caches from local helper scripts
__pycache__/
