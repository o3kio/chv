[Unit]
Description=CHV Node Agent
After=network.target chv-controlplane.service chv-stord.service chv-nwd.service
Wants=chv-controlplane.service chv-stord.service chv-nwd.service

[Service]
Type=simple
User=chv
Group=chv
UMask=002
ExecStartPre=+/usr/bin/install -d -m 0700 -o chv -g chv /run/chv/core /var/lib/chv/agent /var/lib/chv/cache
ExecStart=/usr/bin/chv-agent /etc/chv/agent.toml
# UMask protects Core state. chv-agent explicitly sets its legacy API socket
# mode after bind; no timing-dependent unit chmod is required.
Restart=on-failure
RestartSec=5
# VMs outlive the agent by design: cloud-hypervisor is a child of this unit,
# and the restarted agent adopts the living VMM through its API socket.
# `KillMode=process` kills only the agent on stop/restart; `mixed` (the
# previous setting) sends SIGKILL to the whole cgroup as soon as the main
# process exits, which killed every running VM on `systemctl restart
# chv-agent`. Stopping this unit therefore leaves running VMs running — stop
# the VMs through the API if that is the intent.
KillMode=process
# The agent's core executor drains in-flight journal operations for up to
# CORE_EXECUTOR_DRAIN_BUDGET (60s) on SIGTERM before it marks anything
# restart-interrupted. SIGKILL before that budget elapses strands in-flight
# operations in the journal (the primary operator-triggerable
# InspectRequired path on `systemctl restart`) — so the stop timeout must
# exceed the drain budget with margin.
TimeoutStopSec=75
# Nested, not the parent: `RuntimeDirectory=chv` made systemd remove
# /run/chv recursively on every stop/restart, unlinking the separately
# managed chv-stord/chv-nwd sockets while those daemons kept running. The
# supervisor then could not adopt them, double-spawned duplicates that died
# on the already-bound metrics ports, and the node stayed Failed. Only the
# agent's own directory may be removed by the agent's lifecycle.
RuntimeDirectory=chv/agent
RuntimeDirectoryMode=0775
StateDirectory=chv/agent
StateDirectoryMode=0700
LogsDirectory=chv

# Device access for KVM
DeviceAllow=/dev/kvm rw
SupplementaryGroups=kvm

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/chv /var/lib/chv
ReadOnlyPaths=/etc/chv /usr/bin

# Legacy cleanup retains its established behavior. Only the native Core
# listener uses inode-safe cleanup. The persistent Core lease is never removed.
ExecStopPost=-/bin/rm -f /run/chv/agent/api.sock

[Install]
WantedBy=multi-user.target
